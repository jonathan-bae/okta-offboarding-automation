# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real secrets.

# Okta org URL, no trailing slash (Admin Console URL without "-admin")
OKTA_DOMAIN=https://integrator-XXXXXXX.okta.com

# Security > API > Tokens in the Okta Admin Console. Shown only once.
OKTA_API_TOKEN=replace-me

# Slack incoming webhook for #it-offboarding
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Shared secret callers must send in the X-Webhook-Token header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SHARED_SECRET=replace-me


